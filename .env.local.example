# Clé API Resend (https://resend.com) — nécessaire pour que le formulaire de contact envoie de vrais emails.
RESEND_API_KEY=

# Optionnel : adresse d'expédition personnalisée une fois un domaine vérifié sur Resend.
# Par défaut, "onboarding@resend.dev" est utilisé (fonctionne sans domaine vérifié, en sandbox).
CONTACT_FROM_EMAIL=
